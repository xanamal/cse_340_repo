<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>
    <h2><%= project[0].title %></h2>
    <h3><%= project[0].name %></h3>
    <p>Description: <%= project[0].description %></p>
        <ul>
            <% categories.forEach(category => { %>
                <li><a href="/category/<%= category.category_id %>"><%= category.name %></a><br>Location:  <%= project[0].location%> <br> Date: <%= project[0].date%> </li>
            <% }); %>
        </ul>
</main>
<%- include('partials/footer') %>