<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>
        <% if (user && user.role_name === 'admin') { %>
            <p><a href="/new-project">Add a New Service Project</a></p>
        <% } %>
        <ul>
            <% projects.forEach(project => { %>
                <li>Date: <%= project.date%> <a href="/project/<%= project.project_id %>"><%= project.title%></a>(<a href="/organization/<%= project.organization_id %>"><%= project.name %>)</a></li>
            <% }); %>
        </ul>
</main>
<%- include('partials/footer') %>
